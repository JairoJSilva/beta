services:
  n22-beta:
    image: beta:5.04.03
      #image: beta:5.03.24
    container_name: n22-beta
    hostname: n22-beta
    restart: always
    ports:
      - "50022:8080"
    
    volumes:
      #- /home/sftpupload/imagens/_data/:/var/www/html/vempostovirtual/  
      - /home/imagens/:/var/www/html/vempostovirtual/  
    networks:
      producao:
        ipv4_address: 172.18.2.2


networks:
  producao:
    external: true
